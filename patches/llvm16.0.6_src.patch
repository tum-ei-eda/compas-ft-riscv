+namespace riscv_common {
+// Validate optional instruction-category suffixes on CFP function selections.
+class RsmSelectionParser : public llvm::cl::parser<std::string> {
+public:
+  explicit RsmSelectionParser(llvm::cl::Option &O)
+      : llvm::cl::parser<std::string>(O) {}
+  bool parse(llvm::cl::Option &O, llvm::StringRef, llvm::StringRef Arg,
+             std::string &Value) {
+    auto remaining = Arg;
+    while (!remaining.empty()) {
+      const auto item = remaining.split(',');
+      const auto entry = item.first.trim();
+      const auto colon = entry.rfind(':');
+      const auto name =
+          (colon == llvm::StringRef::npos ? entry : entry.take_front(colon)).trim();
+      if (name.empty())
+        return O.error("expected a function name or -1");
+      if (colon != llvm::StringRef::npos) {
+        auto expression = entry.drop_front(colon + 1);
+        if (expression.empty())
+          return O.error("empty RSM instruction selection");
+        if (expression != "all") {
+          unsigned seen = 0;
+          while (!expression.empty()) {
+            const auto token = expression.split('+');
+            const unsigned bit = token.first == "orig" ? 1
+                               : token.first == "dmr" ? 2
+                               : token.first == "balance" ? 4 : 0;
+            if (!bit)
+              return O.error("expected orig, dmr, balance, '+' combinations, or all");
+            if (seen & bit)
+              return O.error("duplicate instruction category in RSM selection");
+            seen |= bit;
+            if (expression.endswith("+"))
+              return O.error("empty instruction category in RSM selection");
+            expression = token.second;
+          }
+        }
+      }
+      if (remaining.endswith(","))
+        return O.error("empty function in RSM selection");
+      remaining = item.second;
+    }
+    Value = Arg.str();
+    return false;
+  }
+};
+}
